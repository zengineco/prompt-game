# Copy to .env.local and fill in. (Vite only exposes vars prefixed with VITE_.)
# CI uses GitHub repo Variables of the same names.

# Discord Application ID (Dev Portal → General Information → Application ID). Public.
VITE_DISCORD_CLIENT_ID=your_application_id_here

# Supabase (Zengine Games Backend). Anon key is public, protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_jwt_key
